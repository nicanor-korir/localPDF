{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-worker.mjs && next build && node scripts/generate-sw.mjs",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/organise",
      "destination": "/organise.html"
    },
    {
      "source": "/extract",
      "destination": "/extract.html"
    },
    {
      "source": "/split",
      "destination": "/split.html"
    },
    {
      "source": "/unlock",
      "destination": "/unlock.html"
    },
    {
      "source": "/protect",
      "destination": "/protect.html"
    },
    {
      "source": "/convert",
      "destination": "/convert.html"
    },
    {
      "source": "/compress",
      "destination": "/compress.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; manifest-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
