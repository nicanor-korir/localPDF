{
  "name": "localpdf",
  "version": "1.0.0",
  "type": "module",
  "description": "PDF tools that never upload your files \u2014 everything runs in your browser",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "node scripts/build-worker.mjs && next build && node scripts/generate-sw.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build-worker": "node scripts/build-worker.mjs",
    "check:offline": "node scripts/check-offline-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  }
}
